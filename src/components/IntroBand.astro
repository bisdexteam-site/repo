---
import { renderInline } from "@/lib/markdown";

/**
 * Full-width band under the header holding the page h1 and an optional
 * lead paragraph. An optional ribbon line sits in a primary strip above it.
 */

interface Props {
  title: string;
  /** Inline Markdown (emphasis, links). */
  lead?: string;
  /** Short line shown in a primary-colored strip above the band. */
  ribbon?: string;
  /** "intro" is the home page intro line; "page" is a text page title. */
  size?: "page" | "intro";
}

const { title, lead, ribbon, size = "page" } = Astro.props;
---

{ribbon && (
  <div class="intro-ribbon">
    <p class="container intro-ribbon__text">{ribbon}</p>
  </div>
)}
<div class:list={["intro-band", `intro-band--${size}`]}>
  <div class="container">
    <div class="intro-band__content">
      <h1 class:list={["intro-band__title", `intro-band__title--${size}`]}>
        {title}
      </h1>
      {lead && <p class="intro-band__lead" set:html={renderInline(lead)} />}
    </div>
  </div>
</div>

<style>
  .intro-ribbon {
    background: var(--color-primary);
  }

  .intro-ribbon__text {
    padding-block: var(--space-3);
    color: var(--color-on-primary);
    font-family: var(--font-heading);
    font-size: var(--text-nav);
    font-weight: 600;
    letter-spacing: 0.4px;
    text-align: center;
    text-transform: uppercase;
  }

  .intro-band {
    border-bottom: var(--rule-hair);
    background: var(--color-surface);
    padding-block: var(--space-8) var(--space-7);
  }

  .intro-band__content {
    max-width: var(--width-reading);
  }

  .intro-band--intro {
    text-align: center;
  }

  .intro-band--intro .intro-band__content {
    max-width: 860px;
    margin-inline: auto;
  }

  .intro-band__title--page {
    font-size: var(--text-title-page);
    line-height: var(--leading-title);
  }

  .intro-band__title--intro {
    font-size: var(--text-intro);
    font-weight: 600;
    line-height: var(--leading-intro);
  }

  .intro-band__lead {
    margin-top: var(--space-5);
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }
</style>
