---
/**
 * One published review. A panel beside the text holds the reviewer details
 * (role, institution type, experience, relationship, date), the verified
 * badge and the reviewer's relevancy ratings; the other column holds the
 * approved text and any disclosures. The panel stacks above the text on
 * narrow screens. The review text is rendered exactly as approved.
 */
import { render } from "astro:content";

import RelevancyMeter from "@/components/RelevancyMeter.astro";
import type { Review } from "@/lib/content";
import { formatMonth } from "@/lib/dates";

interface Props {
  review: Review;
}

const { review } = Astro.props;
const data = review.data;
const { Content } = await render(review);
const capitalize = (value: string) =>
  value.charAt(0).toUpperCase() + value.slice(1);
const details = [
  { label: "Reviewer", value: capitalize(data.role) },
  { label: "Institution", value: capitalize(data.institutionType) },
  { label: "Experience", value: capitalize(data.experience) },
  { label: "Relationship", value: capitalize(data.relationship) },
];
const headingId = `review-${review.id.replaceAll("/", "-")}`;
---

<article class="review" aria-labelledby={headingId}>
  <h3 class="visually-hidden" id={headingId}>
    Review from {formatMonth(data.date)}
  </h3>
  <div class="review__panel">
    <dl class="review__details">
      {details.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
      <div>
        <dt>Reviewed</dt>
        <dd>
          <time datetime={data.date}>{formatMonth(data.date)}</time>
        </dd>
      </div>
    </dl>
    <p class="review__badge">
      <svg
        width="14"
        height="14"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 8.5l3.5 3.5L13 4.5"></path>
      </svg>
      Verified by BISdex editors
    </p>
    {data.relevancy && <RelevancyMeter {...data.relevancy} />}
  </div>
  <div class="review__body">
    <div class="review__text">
      <Content />
    </div>
    {data.disclosures?.map((disclosure) => (
      <p class="review__disclosure">
        <strong>Disclosure:</strong> {disclosure.label}. {disclosure.text}
      </p>
    ))}
  </div>
</article>

<style>
  .review {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-5) var(--space-6);
    padding-block: var(--space-6);
    border-bottom: var(--rule-hair);
  }

  .review:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .review__panel {
    flex: 1 0 240px;
    max-width: 260px;
    padding: var(--space-4) 18px;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .review__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }

  .review__details dt {
    color: var(--color-text-secondary);
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .review__details dd {
    margin: 0;
    font-size: 1rem;
    line-height: var(--leading-small);
  }

  .review__badge {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: var(--space-3) 0 0;
    color: var(--color-primary);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .review__body {
    flex: 999 1 360px;
    min-width: 0;
  }

  .review__text :global(p) {
    margin: 0;
  }

  .review__text :global(p + p) {
    margin-top: var(--space-4);
  }

  .review__disclosure {
    margin: var(--space-3) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }

  .review__disclosure strong {
    color: var(--color-text);
  }
</style>
