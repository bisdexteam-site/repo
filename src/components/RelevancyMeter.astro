---
/**
 * A reviewer's relevancy ratings, sized for the review panel: one row per
 * audience they rated, each with a small three-segment meter and the rating
 * in words. The words carry the meaning; the meter is hidden from assistive
 * technology. A link explains the ratings in the Editorial Policy.
 */

type Level = "Low" | "Average" | "High";

interface Props {
  researchers?: Level;
  teaching?: Level;
  commercial?: Level;
  headingLevel?: "h3" | "h4";
}

const { headingLevel = "h4", ...ratings } = Astro.props;

const audiences = [
  { key: "researchers", label: "Researchers" },
  { key: "teaching", label: "Teaching / Students" },
  { key: "commercial", label: "Commercial / Industry" },
] as const;

const filled: Record<Level, number> = { Low: 1, Average: 2, High: 3 };
const rows = audiences.flatMap(({ key, label }) => {
  const level = ratings[key];
  return level ? [{ label, level }] : [];
});
const Heading = headingLevel;
---

{rows.length > 0 && (
  <div class="relevancy">
    <Heading class="relevancy__heading">Relevancy (anecdotal)</Heading>
    <dl class="relevancy__rows">
      {rows.map((row) => (
        <div class="relevancy__row">
          <dt>{row.label}</dt>
          <dd>
            <span class="relevancy__meter" aria-hidden="true">
              {[1, 2, 3].map((segment) => (
                <span
                  class:list={[
                    "relevancy__segment",
                    { "relevancy__segment--on": segment <= filled[row.level] },
                  ]}
                />
              ))}
            </span>
            <span class="relevancy__level">{row.level}</span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="relevancy__link">
      <a href="/editorial-policy/#relevancy-ratings">What these mean</a>
    </p>
  </div>
)}

<style>
  .relevancy {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
  }

  .relevancy__heading {
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .relevancy__rows {
    margin: var(--space-2) 0 var(--space-1);
  }

  .relevancy__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: 3px;
    font-size: 0.875rem;
  }

  .relevancy__row dd {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .relevancy__meter {
    display: flex;
    gap: 3px;
  }

  .relevancy__segment {
    width: 18px;
    height: 8px;
    background: var(--color-rule);
  }

  .relevancy__segment--on {
    background: var(--color-primary);
  }

  .relevancy__level {
    min-width: 4.2em;
    color: var(--color-primary);
    font-weight: 700;
  }

  .relevancy__link {
    margin: 0;
    font-size: 0.875rem;
  }
</style>
