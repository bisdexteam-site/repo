{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bisdex",
  "compatibility_date": "2026-10-19",
  // Static site: no Worker script, only the built files in ./dist.
  "assets": {
    "directory": "./dist/",
    // Unknown routes get the nearest 404.html with a 404 status.
    "not_found_handling": "404-page",
    // Pages are built as <route>/index.html and served at <route>/.
    "html_handling": "auto-trailing-slash",
  },
  // Branch previews use the same settings as production; the block must exist.
  "previews": {},
}
